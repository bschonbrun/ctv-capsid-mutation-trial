{
  "permissions": {
    "deny": [
      "mcp__context7__apply_migration",
      "mcp__context7__deploy_edge_function",
      "mcp__context7__execute_sql",
      "mcp__playwright__apply_migration",
      "mcp__playwright__deploy_edge_function",
      "mcp__playwright__execute_sql",
      "mcp__supabase__apply_migration",
      "mcp__supabase__deploy_edge_function",
      "mcp__supabase__execute_sql",
      "Edit(./.claude/permissions.stack.json)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/settings.local.json)",
      "Edit(./docs/user/.meta/**)",
      "Edit(./docs/value/.meta/**)",
      "Edit(~/.claude/config/permissions-baseline.json)",
      "Edit(~/.claude/session-state/**)",
      "Edit(~/.claude/settings.json)",
      "Read(./.claude/next_prompt.md)",
      "Read(~/.aws/credentials)",
      "Read(~/.ssh/**)"
    ],
    "ask": []
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/cloud-bootstrap.sh"
          }
        ]
      }
    ]
  },
  "sandbox": {
    "network": {
      "allowedDomains": [
        "api.anthropic.com",
        "api.openai.com",
        "generativelanguage.googleapis.com",
        "api.deepseek.com",
        "api.x.ai",
        "openrouter.ai",
        "access.carbonet.app"
      ]
    }
  }
}
